      <column caption='Luxary' datatype='string' datatype-customized='true' name='[Calculation_1046778637283330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pricing/rate/amount] &gt;= 10000 AND [stars] &gt;= 4.5 THEN &quot;Luxury&quot; ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Find Superhost' datatype='real' name='[Calculation_1046778858790915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [isHostedBySuperhost] THEN 1 ELSE 0 END) / COUNT([isHostedBySuperhost])' />
      </column>
      <column caption='High &amp; Low price ' datatype='string' name='[Calculation_1046778891272201]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;⇙&quot; + &quot;₹&quot; + STR(MIN([pricing/rate/amount])) + &#13;&#10; &quot; - &quot;&#13;&#10; + &quot;⇗&quot; + &quot;₹&quot; + STR(MAX([pricing/rate/amount]))' />
      </column>
      <column caption='Highest Price' datatype='integer' name='[Calculation_1046778893615115]' role='measure' type='quantitative'>
